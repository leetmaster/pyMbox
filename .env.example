# Email (SMTP) configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-sender@gmail.com
MAIL_PASSWD=your-app-password
MAIL_FROM=Mbox Monitor and Support
MAIL_TO=recipient@example.com
MAIL_CC=cc-recipient@example.com
MAIL_SUBJECT=Mbox Monitor and Support

# SFTP configuration
SFTP_HOST=sftp.example.com
SFTP_USER=your-sftp-user
SFTP_PASSWORD=your-sftp-password

# Runtime configuration
TIMEZONE=EST
BODY_FILE=body.txt
FEEDBACK_EMAIL=feedback@example.com

# Intended cadence for the Prefect deployment schedule (seconds).
# 21600 seconds == 6 hours. Not used by the flow itself; the cadence is
# applied via `prefect deploy` (see README.md).
SLEEP_SECONDS=21600
